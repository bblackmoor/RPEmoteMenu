#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
addon_dir="$repo_root/RPEmoteMenu"
toc="$addon_dir/RPEmoteMenu.toc"
dist_dir="$repo_root/dist"

if [ ! -f "$toc" ]; then
    echo "Warning: $toc not found; release package was not created." >&2
    exit 0
fi

version=$(sed -n 's/^## Version:[[:space:]]*//p' "$toc" | head -n 1)
if [ -z "$version" ]; then
    echo "Warning: No version entry found in $toc; release package was not created." >&2
    exit 0
fi

mkdir -p "$dist_dir"
zip_path="$dist_dir/RPEmoteMenu-$version.zip"
rm -f "$zip_path"

if command -v powershell.exe >/dev/null 2>&1 && command -v cygpath >/dev/null 2>&1; then
    addon_win=$(cygpath -w "$addon_dir")
    zip_win=$(cygpath -w "$zip_path")
    powershell.exe -NoProfile -NonInteractive -Command \
        "Compress-Archive -LiteralPath '$addon_win' -DestinationPath '$zip_win' -CompressionLevel Optimal -Force"
elif command -v zip >/dev/null 2>&1; then
    (
        cd "$repo_root"
        zip -qr "$zip_path" RPEmoteMenu
    )
else
    echo "Warning: Neither PowerShell Compress-Archive nor zip is available; release package was not created." >&2
    exit 0
fi

echo "Created release package: dist/RPEmoteMenu-$version.zip"
