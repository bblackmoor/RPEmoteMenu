package-as: RPEmoteMenu

# Flatten the repository's inner addon folder in the installable ZIP.
move-folders:
  RPEmoteMenu/RPEmoteMenu: RPEmoteMenu

# These commits contain the exact library source blobs already tested here.
# Upgrade the pins and bundled development copies together.
externals:
  RPEmoteMenu/Libs/LibStub:
    url: https://github.com/lua-wow/LibStub
    commit: af45e4a862a4b0bd025dfac95f4697ecdbc5b015
    curse-slug: libstub
  RPEmoteMenu/Libs/CallbackHandler-1.0:
    url: https://github.com/WoWUIDev/Ace3
    commit: 40f4cc1356ae7fcc0cf71fc0a19dc7d50d6ae6c2
    path: CallbackHandler-1.0
    curse-slug: callbackhandler
  RPEmoteMenu/Libs/LibSharedMedia-3.0:
    url: https://github.com/SquizzCheeze/Squizzumables
    commit: e40d97410035e5b148c4cbec180af6f2b6317bad
    path: Libs/LibSharedMedia-3.0
    curse-slug: libsharedmedia-3-0
  RPEmoteMenu/Libs/DetailsFramework:
    url: https://github.com/Tercioo/Details-Framework
    commit: 653af57120e1287be784d468324590a9c150ae98
    curse-slug: libdframework

ignore:
  - docs
  - tests
  - scripts
  - Media
  - dist
  - RPEmoteMenu/Libs/README.md
  - RPEmoteMenu/Libs/*/*.toc
  - RPEmoteMenu/Libs/*/*.md
  - RPEmoteMenu/Libs/*/tests
  - RPEmoteMenu/Libs/*/docs
  - RPEmoteMenu/Libs/*/examples
  - RPEmoteMenu/Libs/*/*.examples.lua
  - RPEmoteMenu/Libs/*/*.exemples.lua
  - RPEmoteMenu/Libs/*/*_exemples.lua
  - RPEmoteMenu/Libs/*/*.tests.lua
  - RPEmoteMenu/Libs/*/.checkout
  - RPEmoteMenu/Libs/DetailsFramework/definitions.lua
  - RPEmoteMenu/Libs/LibStub/UPSTREAM_REVISION
  - RPEmoteMenu/Libs/LibStub/CHANGELOG.txt
  - RPEmoteMenu/Libs/CallbackHandler-1.0/CallbackHandler-1.0.xml

plain-copy:
  # Preserve the tested framework core without keyword/line-ending filters.
  - RPEmoteMenu/Libs/DetailsFramework/fw.lua

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
license-output: LICENSE
enable-nolib-creation: no
enable-toc-creation: no
